#include <stdio.h>
#include <math.h>

#define N 100

void ex1(void) {
    int v[N], ord[N];
    int i, j, aux;

    for (i = 0; i < N; i++) {
        printf("Numero %d: ", i + 1);
        scanf("%d", &v[i]);
        ord[i] = v[i];
    }

    printf("\nOrdem inversa da leitura:\n");
    for (i = N - 1; i >= 0; i--)
        printf("%d ", v[i]);

    for (i = 0; i < N - 1; i++) {
        int maior = i;
        for (j = i + 1; j < N; j++)
            if (ord[j] > ord[maior])
                maior = j;
        aux = ord[i];
        ord[i] = ord[maior];
        ord[maior] = aux;
    }

    printf("\n\nOrdenados do maior para o menor:\n");
    for (i = 0; i < N; i++)
        printf("%d ", ord[i]);
    printf("\n");
}
void ex2(void) {
    double x, a;
    int n = 0;

    printf("Digite um valor positivo: ");
    scanf("%lf", &x);

    if (x <= 0) {
        printf("Valor invalido: considere somente valores positivos.\n");
        return;
    }

    a = x;
    while (a >= 10.0) {
        a /= 10.0;
        n++;
    }
    while (a < 1.0) {
        a *= 10.0;
        n--;
    }

    printf("%g = %.6f x 10^%d\n", x, a, n);
}
void ex3(void) {
    unsigned long long n;
    int bits[64], i, qtd = 0;

    printf("Digite n (positivo e <= 64): ");
    scanf("%llu", &n);

    if (n < 1 || n > 64) {
        printf("Valor invalido: n deve ser positivo e menor ou igual a 64.\n");
        return;
    }

    printf("%llu em binario: ", n);
    while (n > 0) {
        bits[qtd++] = (int)(n % 2);
        n /= 2;
    }
    for (i = qtd - 1; i >= 0; i--)
        printf("%d", bits[i]);
    printf("\n");
}
double maiorAB(double a, double b) {
    return (a + b + fabs(a - b)) / 2.0;
}

void ex4(void) {
    double v[10], maior;
    int i;

    for (i = 0; i < 10; i++) {
        printf("Valor %d: ", i + 1);
        scanf("%lf", &v[i]);
    }

    maior = v[0];
    for (i = 1; i < 10; i++)
        maior = maiorAB(maior, v[i]);

    printf("%g eh o maior\n", maior);
}
int ehPrimo(int n) {
    int i;
    if (n < 2) return 0;
    for (i = 2; i * i <= n; i++)
        if (n % i == 0) return 0;
    return 1;
}

void ex5(void) {
    int v[N], i;

    for (i = 0; i < N; i++) {
        printf("Numero %d: ", i + 1);
        scanf("%d", &v[i]);
    }

    printf("\n");
    for (i = 0; i < N; i++) {
        printf("%d: %s e %s\n", v[i],
               (v[i] % 2 == 0) ? "par" : "impar",
               ehPrimo(v[i]) ? "primo" : "nao primo");
    }
}
void ex6(void) {
    double x1[10], y1[10], x2[10], y2[10], d;
    int i;

    printf("--- Vetor x1 ---\n");
    for (i = 0; i < 10; i++) { printf("x1[%d]: ", i); scanf("%lf", &x1[i]); }
    printf("--- Vetor y1 ---\n");
    for (i = 0; i < 10; i++) { printf("y1[%d]: ", i); scanf("%lf", &y1[i]); }
    printf("--- Vetor x2 ---\n");
    for (i = 0; i < 10; i++) { printf("x2[%d]: ", i); scanf("%lf", &x2[i]); }
    printf("--- Vetor y2 ---\n");
    for (i = 0; i < 10; i++) { printf("y2[%d]: ", i); scanf("%lf", &y2[i]); }

    printf("\n");
    for (i = 0; i < 10; i++) {
        d = sqrt(pow(x2[i] - x1[i], 2) + pow(y2[i] - y1[i], 2));
        printf("p1(%g,%g) e p2(%g,%g): distancia = %.4f\n",
               x1[i], y1[i], x2[i], y2[i], d);
    }
}
void ex7(void) {
    int v[N], i, j, k, achou = 0;

    for (i = 0; i < N; i++) {
        printf("Numero %d: ", i + 1);
        scanf("%d", &v[i]);
    }

    printf("\nSequencias consecutivas encontradas:\n");
    i = 0;
    while (i < N) {
        j = i;
        while (j + 1 < N && v[j + 1] == v[j] + 1)
            j++;

        if (j > i) {
            for (k = i; k <= j; k++)
                printf("%d ", v[k]);
            printf("\n");
            achou = 1;
        }
        i = j + 1;
    }

    if (!achou)
        printf("Nenhum valor em ordem consecutiva.\n");
}

