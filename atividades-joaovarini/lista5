    int op;

    do {
        printf("\n===== LISTA DE EXERCICIOS =====\n");
        printf("1 - Ordem inversa e ordenacao (100 inteiros)\n");
        printf("2 - Notacao cientifica\n");
        printf("3 - Decimal para binario\n");
        printf("4 - Maior de 10 valores (URI 1013)\n");
        printf("5 - Paridade e primalidade\n");
        printf("6 - Distancia euclidiana\n");
        printf("7 - Valores consecutivos\n");
        printf("0 - Sair\n");
        printf("Escolha: ");
        scanf("%d", &op);

        switch (op) {
            case 1: ex1(); break;
            case 2: ex2(); break;
            case 3: ex3(); break;
            case 4: ex4(); break;
            case 5: ex5(); break;
            case 6: ex6(); break;
            case 7: ex7(); break;
            case 0: printf("Ate mais!\n"); break;
            default: printf("Opcao invalida.\n");
        }
    } while (op != 0);

    return 0;
}
