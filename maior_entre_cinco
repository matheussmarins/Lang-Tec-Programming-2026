#include <stdio.h>
#include <stdlib.h>

/* Fa�a um programa que LEIA 10 valores do teclado, 
e mostre na tela o maior entre os 5 primeiros 
e o menor entre os 5 restantes */


int compara (int a, int b){
	if (a>b)return a;
	else return b;
}

int main(int argc, char *argv[]) {
	int valores[10];
	int i;
	int maior, menor;
	
	
	printf("Leia os numeros\n");
	// PARA ( INICIAL. CONDICAO, INCREMENTO)
	for(i=0; i<10; i++){
		scanf("%d",&valores[i]);
	}
	for(i=1, maior=valores[0]; i<5;i=i+2){
		int comp_temp = compara(valores[i], valores[i + 1]);
		maior = compara(maior,comp_temp);
		}
	
	printf("\n %d", maior);
	return 0;
}


